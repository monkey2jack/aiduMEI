[Unit]
Description=aiduMEI local embedding shim (bge-small-zh, loopback)
After=network.target

[Service]
Type=simple
User=dev
WorkingDirectory=/opt/aidumem
Environment=HOME=/data/home
ExecStart=/opt/aidumem/.venv/bin/python /opt/aidumem/embed_shim.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
