# aiduMEM REST API —— systemd 单元模板
#
# 安装：
#   sudo cp deploy/aidumem-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now aidumem-api
#
# 改环境变量建议用 override 而不是直接改本文件（升级不会被覆盖）：
#   sudo systemctl edit aidumem-api
#
# ★ 注意 EnvironmentFile 那行：把 .env.example 复制成 .env 并填好
#   AIDUMEM_ENTITY_KEYWORDS，否则涉及你自己人名/项目代号的查询会
#   静默零召回。装完用 `curl -s localhost:8767/health | jq .warnings`
#   确认没有告警。

[Unit]
Description=aiduMEM Memory Engine REST API
Documentation=https://github.com/monkey2jack/aiduMEI
After=network.target
Wants=network.target

# 失败可见性：连续失败 5 次（300 秒窗口内）后进入 failed 并停止重试。
# 没有这两行时，systemd 用默认的 10s/5 —— 而下面 RestartSec=5 意味着
# 10 秒窗口内最多也就 2 次，限流永远触发不了：进程崩一次重启一次，
# 状态长期停在 activating（**不是** failed），按 failed 告警的监控一辈子等不到。
# 同步单元（aidumem-sync.service）为此静默停摆过 8 天、重启 6000+ 次。
#
# ★ 必须写在 [Unit] 段。写进 [Service] 会被 systemd 直接忽略
#   （255 实测：Unknown key name ... in section 'Service', ignoring），
#   生效值仍是默认 10s —— 看着修了，其实没修。
#   验收只认 `systemctl show aidumem-api -p StartLimitIntervalUSec`。
#
# 权衡：这会让 API 在连续崩溃后**停止**自动重启，需要人工介入。这是刻意的 ——
# 一个 5 分钟内崩 5 次的服务，自动重启只会把故障拖成静默的长期不可用。
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/opt/aidumem

# 环境变量集中放在 .env，`-` 前缀表示文件缺失不阻止启动
EnvironmentFile=-/opt/aidumem/.env
Environment=MEM0_API_PORT=8767
Environment=MEM0_TELEMETRY=false

ExecStart=/opt/aidumem/venv/bin/python3 /opt/aidumem/api_server.py
Restart=always
RestartSec=5

StandardOutput=append:/opt/aidumem/logs/api_server.log
StandardError=append:/opt/aidumem/logs/api_server.log

[Install]
WantedBy=multi-user.target
