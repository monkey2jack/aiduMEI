# aiduMEM REST API —— systemd 单元模板
#
# 安装：
#   sudo cp deploy/aidumem-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now aidumem-api
#
# 改环境变量建议用 override 而不是直接改本文件（升级不会被覆盖）：
#   sudo systemctl edit aidumem-api
#
# ★ 注意 EnvironmentFile 那行：把 .env.example 复制成 .env 并填好
#   AIDUMEM_ENTITY_KEYWORDS，否则涉及你自己人名/项目代号的查询会
#   静默零召回。装完用 `curl -s localhost:8767/health | jq .warnings`
#   确认没有告警。
#
# ★ 降权前置（v20.0 P3-8）—— 装单元之前必须先建账号并交接数据目录，
#   否则服务会以 `status=200/CHDIR` 或 `sqlite3.OperationalError: unable to
#   open database file` 起不来（**且不会告诉你是权限问题**）：
#
#     sudo useradd --system --no-create-home --shell /usr/sbin/nologin aidumem
#     sudo chown -R aidumem:aidumem /opt/aidumem/data /opt/aidumem/logs
#     sudo chmod 750 /opt/aidumem/data /opt/aidumem/logs
#     sudo chown root:aidumem /opt/aidumem/.env && sudo chmod 640 /opt/aidumem/.env
#
#   为什么 data/ 要**整棵** chown：SQLite 的 WAL 模式不是只写主库文件。
#   写事务要在同目录建 `-wal` 和 `-shm`，checkpoint 之后还要删掉重建。
#   只 chown 主库文件、目录仍归 root，表现是「读得到、写不进」——
#   而只读查询全部正常，`/health` 也绿，直到第一次写入才炸。
#
#   ★ 附带前提：cron 里跑的 scripts/*.py 也要一起降权（同一批库）。
#     `ducky.utils` 在 **import 时**就会 `ensure_evolution_tables()` 建连，
#     所以哪怕脚本本身只是个 HTTP 客户端（如 consolidator.py），
#     只要 import 了它就会以当前身份打开 facts.db 并可能建出 root 属主的
#     `-wal`/`-shm`。留一个 root 写手，就会周期性地把整棵目录重新污染成
#     混属主，然后降权后的服务在下一次写入时失败。cron 行改成：
#         30 2 * * * runuser -u aidumem -- /opt/aidumem/venv/bin/python3 ...

[Unit]
Description=aiduMEI Memory Engine REST API
Documentation=https://github.com/monkey2jack/aiduMEI
After=network.target
Wants=network.target

# 失败可见性：一小时窗口内启动 30 次后进入 failed 并停止重试。
# 没有这两行时，systemd 用默认的 10s/5 —— 而下面 RestartSec=5 意味着
# 10 秒窗口内最多也就 2 次，限流永远触发不了：进程崩一次重启一次，
# 状态长期停在 activating（**不是** failed），按 failed 告警的监控一辈子等不到。
# 同步单元（aidumem-sync.service）为此静默停摆过 8 天、重启 6000+ 次。
#
# ★ 必须写在 [Unit] 段。写进 [Service] 会被 systemd 直接忽略
#   （255 实测：Unknown key name ... in section 'Service', ignoring），
#   生效值仍是默认 10s —— 看着修了，其实没修。
#   验收只认 `systemctl show aidumem-api -p StartLimitIntervalUSec`。
#
# ★ 为什么 API 用 3600/30，而 sync 用 300/5（两个单元**刻意不同**）：
#   这两个单元要守的东西是相反的。
#     · API 一停 = 调用方当场失忆（查不到、写不进）。它的第一价值是**在线**。
#     · sync 一停 = MEMORY.md 晚点同步，几小时无感。它的第一价值是**被发现**
#       —— 它就是那个静默停摆 8 天的惯犯。
#   所以 API 应该对故障更宽容，sync 应该更早地死给人看。
#
#   放宽 API 又不牺牲可见性，靠的是崩溃循环与偶发抖动的**形状不同**：
#     · 崩溃循环是**密集**的 —— RestartSec=5s 意味着 30 次只要 150 秒 ≈ 2.5 分钟，
#       远小于 3600 秒窗口，照样撞线进 failed。可见性一点没丢。
#     · 偶发抖动（依赖闪断、后端超时、OOM 后自愈）是**稀疏**的 ——
#       一小时零星崩十几次也凑不满 30，全部放过，服务自己扛过去。
#   反过来，300/5 对 API 太狠：25 秒内连崩 5 次就停住等人，
#   而这恰恰是一次抖动就能达成的量级 —— 用「彻底失忆」去换一点点可见性，不划算。
#
#   一句话：长窗口 + 大计数，对稀疏宽容、对密集仍敏感。这不是二选一。
#
# 权衡：真正进入崩溃循环时，API 仍会在约 2.5 分钟后**停止**自动重启，需要人工介入。
# 这是刻意的 —— 一个持续崩溃的服务，无限重启只会把故障拖成静默的长期不可用。
StartLimitIntervalSec=3600
StartLimitBurst=30

[Service]
Type=simple

# ── 身份（v20.0 P3-8）──
# 在此之前这里是 User=root。一个只做「本机回环上的记忆读写」的服务，
# 拿着 CAP_SYS_ADMIN / CAP_NET_RAW / CAP_SYS_PTRACE 这类能力没有任何用途，
# 只是把一次反序列化或依赖链上的 RCE 从「丢记忆」放大成「丢整机」。
# 建账号见文件头。数据目录没交接好就改这行 = 服务起不来，顺序不能颠倒。
User=aidumem
Group=aidumem

WorkingDirectory=/opt/aidumem

# 环境变量集中放在 .env，`-` 前缀表示文件缺失不阻止启动
EnvironmentFile=-/opt/aidumem/.env
Environment=MEM0_API_PORT=8767
Environment=MEM0_TELEMETRY=false

ExecStart=/opt/aidumem/venv/bin/python3 /opt/aidumem/api_server.py
Restart=always
RestartSec=5

StandardOutput=append:/opt/aidumem/logs/api_server.log
StandardError=append:/opt/aidumem/logs/api_server.log

# ══ 沙箱加固（v20.0 P3-8）══
# 每一行都按「这个服务实际用到什么」裁的，不是抄模板。
# 验收只认 `systemd-analyze security aidumem-api`（看 systemd 自己算的暴露分），
# 不是 grep 本文件 —— 写了不等于生效。
#
# 提权面
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
#   ↑ CapabilityBoundingSet 留空 = 一个 capability 都不给。
#     本服务只监听 8767（>1024），不需要 CAP_NET_BIND_SERVICE。
#     若你把端口改到 1024 以下，这里要补 CAP_NET_BIND_SERVICE，否则起不来。

# 文件系统面
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/aidumem/data /opt/aidumem/logs
PrivateTmp=yes
#   ↑ ProtectSystem=strict 把整个文件系统挂成只读，再用 ReadWritePaths 开两个洞。
#     ★ 这两个洞必须**同时**开：只开 data/ 会让 StandardOutput 的 append 失败，
#       而 systemd 对此的表现是单元直接 failed，日志里只有一句
#       `Failed to open ... Read-only file system` —— 很容易误判成磁盘故障。
#     ★ 若你换了 AIDUMEM_DATA_DIR / AIDUMEM_LOG_DIR，这里要跟着改。
#       忘了改的症状同样是「读得到、写不进」。
#     ★ ProtectHome=yes 会让 /home 与 /root 不可见。API 不读任何家目录，
#       所以安全；但 aidumem-sync 要读 ~/.hermes/memories/MEMORY.md，
#       那个单元里**不能**照抄这一行（见 aidumem-sync.service 的说明）。

# 内核与设备面
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
PrivateDevices=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
#   ↑ ProcSubset=pid 故意**没有**启用：/health 的资源探针读 /proc/self/status
#     取 RSS，ProcSubset=pid 之下 /proc/self 仍可读，但探针在部分内核上
#     会退化。宁可少一分硬化，也不要让唯一的可观测入口变哑。

# 网络面
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=localhost
IPAddressDeny=any
#   ↑ 默认只允许回环：本服务的出站需求（嵌入/重排/LLM）走的是**上游网关**，
#     而网关地址由部署方自己配。
#     ★ 如果你的 embedder / reranker / LLM 直连公网 API，
#       上面两行会让所有出站被静默丢弃 —— 表现是超时，不是拒绝，
#       排查起来极其费时。此时请把 IPAddressAllow 补成你的上游网段，
#       或整块注释掉这两行。宁可先注释掉，也不要留着半通不通。

# 系统调用面
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
#   ↑ @system-service 是 systemd 给「普通服务」的预置集合，
#     覆盖 sqlite / httpx / uvicorn 的全部需求（生产实测通过）。
#     ★ 不要收得比这更窄：resource_probe 在 /proc 读不到时会退到
#       `subprocess.run(["lsof", ...])`，@system-service 之外的过滤器
#       会让这条退路以 EPERM 失败。它有 try/except 兜底，不至于崩，
#       但你会永久丢掉 open_fds 这个指标。

[Install]
WantedBy=multi-user.target
