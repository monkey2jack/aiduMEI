# ═══════════════════════════════════════════════════════════════════
# aiduMEM 环境变量样例 —— 复制成 .env 后按需修改
#   cp .env.example .env
#
# 全部可选：不设置就走安全默认值。但请务必读一遍 ENTITY_KEYWORDS 那节，
# 漏配它不会报错，只会让涉及你自己人名/项目代号的查询静默零召回。
# ═══════════════════════════════════════════════════════════════════

# ── 路径与落盘 ──────────────────────────────────────────────────
# AIDUMEM_HOME=/opt/aidumem
# AIDUMEM_DATA_DIR=/data/aidumem
# AIDUMEM_LOG_DIR=/var/log/aidumem
# AIDUMEM_CONFIG_FILE=/opt/aidumem/mem0_config_local.json

# ── 服务 ────────────────────────────────────────────────────────
# AIDUMEM_API_PORT 优先于 MEM0_API_PORT
MEM0_API_PORT=8767
# AIDUMEM_API_PORT=8767
MEM0_TELEMETRY=false
# AIDUMEM_API_BASE=http://127.0.0.1:8767
# AIDUMEM_SERVICE=aidumem-api
# REST API 访问令牌：设置后所有接口强制携带凭据（v19.1.1 起）。
# 本地/回环部署可不设；对外部署必须设置。
# AIDUMEM_API_TOKEN=change-me-please

# ── 鉴权门禁语义（v19.4.1 P0-1 鉴权贯通）─────────────────────────
# 门禁是「一道门两把钥匙」，任一有效即放行：
#   钥匙 A：控制台登录后签发的 HttpOnly session cookie（浏览器自动携带）
#   钥匙 B：Authorization: Bearer <AIDUMEM_API_TOKEN>（脚本 / MCP / CI 用）
#
# 门禁在下列任一条件成立时**启用**：
#   · 设置了 AIDUMEM_API_TOKEN
#   · 设置了 AIDUMEM_UI_PASSWORD
#   · 通过控制台「修改密码」显式改过密（哈希文件标记 source=user）
#
# 服务首次启动时自动生成的随机口令**不启用**门禁 —— 它只守控制台登录。
# 这样存量部署（hermes 插件 / MCP / cron 走回环、不带凭据）升级后行为不变。
# 想给 REST 接口上锁，请显式设置上面任一项。
# 当前门禁状态可在 /health 的 probes.auth_gate_enabled 查看。
#
# HTTPS 反代后建议开启，让会话 cookie 只走加密连接：
# AIDUMEM_COOKIE_SECURE=1
# 会话有效期（秒，默认 43200 = 12 小时）：
# AIDUMEM_SESSION_TTL_SECONDS=43200

# ── aiduMEI 控制台 ──────────────────────────────────────────────
# 控制台静态文件目录（不存在则仅 API 模式运行）
# UI_DIR=/opt/aidumem/frontend
# 配置只读模式（1=禁止在线修改 _speed 参数，演示/生产建议开启）
# AIDUMEM_CONFIG_READONLY=1
# 控制台登录密码（不设置且无哈希文件时会自动生成高强度随机密码，生产请务必自定义）
# 注意：显式设置本项会同时启用 REST 接口门禁（见上方「鉴权门禁语义」）。
# 口令以 PBKDF2-HMAC-SHA256（200k 轮）哈希存储，文件权限 0600；
# v19.4.0 及之前的单轮 sha256 哈希在首次登录成功后自动升级（v19.4.1 P2-2）。
# AIDUMEM_UI_PASSWORD=change-me-please

# ── 身份与租户可见性 ────────────────────────────────────────────
# AIDUMEM_DEFAULT_USER_ID=default
# AIDUMEM_DEFAULT_AGENT_ID=local
#
# 租户可见性档位（v19.4.1 P0-2）：
#   宽松档（默认）：传具体 user_id 时，可见集合 =
#       agent_id=user_id ∨ source=user_id ∨ agent_id=<DEFAULT_AGENT_ID>
#     最后一项兜住「未标记租户归属的历史数据」，保证存量库升级后不丢可见性。
#   严格档：只按 agent_id / source 精确匹配，不兜未标记数据。
#     确实要做租户硬隔离时开启（注意：可能让未标记的历史记忆召回不到）。
# AIDUMEM_STRICT_TENANT=0
# AIDUMEM_DEFAULT_AGENT_NAME=Default Agent
# 历史 user_id 映射：把存量库里的旧名字映射到 default，逗号分隔。
# 开源仓库不再硬编码 admin/user 映射，需要的部署方自行配置。
# AIDUMEM_LEGACY_USER_IDS=admin,user

# ── v19.0 认知层（P0 Reflect / 自编辑 / 检索时间窗）──────────────
# Reflect 后台主动反思开关与间隔（小时）。关闭后手动 POST /reflect 不受影响。
# AIDUMEM_REFLECT_ENABLED=true
# AIDUMEM_REFLECT_INTERVAL_HOURS=6
# 记忆去重自编辑开关。关闭后 /add 回退到 Layer1 Jaccard 去重。
# 注意成本：开启时每次写入前会对相似候选做一次 LLM 判重，
# 高频写入场景会增加延迟与 token 消耗；低写入或重质量场景建议开启。
# AIDUMEM_SELF_EDIT_ENABLED=true
# 检索时间衰减率 λ：越大旧记忆衰减越快；0 表示完全不衰减。
# AIDUMEM_RECENCY_LAMBDA=0.01

# ── v19.0 P1（类型分离 / Skill 生长 / 递归精炼）────────────────────
# LLM 辅助判型（开启后写入时用 LLM 判记忆类型；关闭则纯规则判型）
# AIDUMEM_TYPE_CLASSIFY_ENABLED=false
# 自动 Skill 生长：开启后 /skill/grow 允许调用 LLM 生成草稿
# AIDUMEM_SKILL_GROWTH_ENABLED=false
# 记忆递归精炼：开启后 /memory/refine 允许调用 LLM 生成合并摘要
# AIDUMEM_REFINE_ENABLED=false

# ── 相关性闸门词表（★ 最容易漏配的一项）────────────────────────
#
# 闸门先判「这句话需不需要查记忆」，再决定是否召回。判据里的通用模式
# （我的/还记得/上次说过…）内置在源码里，但你专属的人名、昵称、项目
# 代号、机房代号不可能硬编码在开源仓库里 —— 必须从这里注入。
#
# 漏配的后果：问「Alice 的生日是哪天」会被判成 no_signal 直接零召回，
# 且不报错、不打警告，只是查不到。v15 起 GET /health 会在
# probes.entity_keywords_ok=false 时给出 warnings 提示。
#
# 用 `|` 分隔，元字符会被自动转义（当字面量处理）。
# AIDUMEM_ENTITY_KEYWORDS=Alice|Bob|ProjectX|Acme Corp
# AIDUMEM_SERVER_KEYWORDS=tokyo|osaka|prod-cluster
# AIDUMEM_DATE_KEYWORDS=founding day|anniversary

# ── 分层衰减 ────────────────────────────────────────────────────
# L0 = 零衰减（永不降权），按 category 精确匹配
# AIDUMEM_L0_CATEGORIES=iron_law,passphrase,auth
# L1 = 慢衰减，按 category 前缀匹配
# AIDUMEM_L1_PREFIXES=identity_,preference_

# ── 宿主 Agent 对接（可选）──────────────────────────────────────
# AIDUMEM_HOST_STATE_DB=/path/to/hermes/state.db
# AIDUMEM_HOST_MEMORY_MD=/path/to/hermes/MEMORY.md

# ── 上游 LLM 网关用量采集（可选，默认关闭，见 ducky/router_usage.py）──
# v19.4.1 P2-4：该模块通过 ssh 在远端主机执行查询脚本，属纯运维观测能力，
# 与记忆主链路无关。默认**不加载不执行**，需要时显式开启并自行确认信任前提
# （远端主机可信、ssh 私钥可信、known_hosts 已预置）。
# AIDUMEM_ROUTER_USAGE_ENABLED=1
# 首次连接的主机密钥策略（默认 accept-new；预置 known_hosts 后建议改 yes）
# AIDUMEM_ROUTER_SSH_STRICT=accept-new
# AIDUMEM_ROUTER_SSH_HOSTS=user@10.0.0.2,user@203.0.113.5
# AIDUMEM_ROUTER_SSH_KEY=/path/to/ssh_private_key
# AIDUMEM_ROUTER_DB_PATH=~/router-data/db/data.sqlite
# AIDUMEM_ROUTER_KEY_SUFFIX=
# AIDUMEM_ROUTER_MODELS=
