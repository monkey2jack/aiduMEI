# ═══════════════════════════════════════════════════════════════════
# aiduMEI 环境变量样例 —— 复制成 .env 后按需修改
#   cp .env.example .env
#
# 全部可选：不设置就走安全默认值。但请务必读一遍 ENTITY_KEYWORDS 那节，
# 漏配它不会报错，只会让涉及你自己人名/项目代号的查询静默零召回。
# ═══════════════════════════════════════════════════════════════════

# ── 路径与落盘 ──────────────────────────────────────────────────
# AIDUMEM_HOME=/opt/aidumem
# AIDUMEM_DATA_DIR=/data/aidumem
# AIDUMEM_LOG_DIR=/var/log/aidumem
# AIDUMEM_CONFIG_FILE=/opt/aidumem/mem0_config_local.json

# ── 服务 ────────────────────────────────────────────────────────
# AIDUMEM_API_PORT 优先于 MEM0_API_PORT
MEM0_API_PORT=8767
# AIDUMEM_API_PORT=8767
MEM0_TELEMETRY=false
# AIDUMEM_API_BASE=http://127.0.0.1:8767
# AIDUMEM_SERVICE=aidumem-api
# REST API 访问令牌：设置后所有接口强制携带凭据（v19.1.1 起）。
# 本地/回环部署可不设；对外部署必须设置。
# AIDUMEM_API_TOKEN=change-me-please

# ── 鉴权门禁语义（v19.4.1 P0-1 鉴权贯通）─────────────────────────
# 门禁是「一道门两把钥匙」，任一有效即放行：
#   钥匙 A：控制台登录后签发的 HttpOnly session cookie（浏览器自动携带）
#   钥匙 B：Authorization: Bearer <AIDUMEM_API_TOKEN>（脚本 / MCP / CI 用）
#
# 门禁在下列任一条件成立时**启用**：
#   · 设置了 AIDUMEM_API_TOKEN
#   · 设置了 AIDUMEM_UI_PASSWORD
#   · 通过控制台「修改密码」显式改过密（哈希文件标记 source=user）
#
# 服务首次启动时自动生成的随机口令**不启用**门禁 —— 它只守控制台登录。
# 这样存量部署（hermes 插件 / MCP / cron 走回环、不带凭据）升级后行为不变。
# 想给 REST 接口上锁，请显式设置上面任一项。
# 当前门禁状态可在 /health 的 probes.auth_gate_enabled 查看。
#
# HTTPS 反代后建议开启，让会话 cookie 只走加密连接：
# AIDUMEM_COOKIE_SECURE=1
#
# API 文档（/docs /redoc /openapi.json）是否免凭据。
# 门禁启用后默认**一并保护** —— 这三个路径会吐出全部端点清单（含参数与
# 请求体结构），公开它们等于给未授权访问者一份攻击面地图。
# 本机开发、或已在反代层另加保护时可显式放开：
# AIDUMEM_PUBLIC_DOCS=1
# 会话有效期（秒，默认 43200 = 12 小时）：
# AIDUMEM_SESSION_TTL_SECONDS=43200

# ── aiduMEI 控制台 ──────────────────────────────────────────────
# 控制台静态文件目录（不存在则仅 API 模式运行）
# UI_DIR=/opt/aidumem/frontend
# 配置只读模式（1=禁止在线修改 _speed 参数，演示/生产建议开启）
# AIDUMEM_CONFIG_READONLY=1
# 控制台登录密码（不设置且无哈希文件时会自动生成高强度随机密码，生产请务必自定义）
# 注意：显式设置本项会同时启用 REST 接口门禁（见上方「鉴权门禁语义」）。
# 口令以 PBKDF2-HMAC-SHA256（200k 轮）哈希存储，文件权限 0600；
# v19.4.0 及之前的单轮 sha256 哈希在首次登录成功后自动升级（v19.4.1 P2-2）。
# AIDUMEM_UI_PASSWORD=change-me-please

# ── 身份与租户可见性 ────────────────────────────────────────────
# AIDUMEM_DEFAULT_USER_ID=default
# AIDUMEM_DEFAULT_AGENT_ID=local
#
# 租户可见性档位（v19.4.1 P0-2）：
#   宽松档（默认）：传具体 user_id 时，可见集合 =
#       agent_id=user_id ∨ source=user_id ∨ agent_id=<DEFAULT_AGENT_ID>
#     最后一项兜住「未标记租户归属的历史数据」，保证存量库升级后不丢可见性。
#   严格档：只按 agent_id / source 精确匹配，不兜未标记数据。
#     确实要做租户硬隔离时开启（注意：可能让未标记的历史记忆召回不到）。
# AIDUMEM_STRICT_TENANT=0
#
# 严格档额外收紧的两条枚举型路由（v19.4.1）：
#   /events/history 与 /opinions 以自增整数 id 为入口，可被顺序枚举。
#   单机自托管下这是可接受的设计定位；开启严格档后它们同样按租户可见性
#   校验，不可见即视为不存在 —— 避免「别处都收窄了、这两条还敞着」。
# AIDUMEM_DEFAULT_AGENT_NAME=Default Agent
# 历史 user_id 映射：把存量库里的旧名字映射到 default，逗号分隔。
# 开源仓库不再硬编码 admin/user 映射，需要的部署方自行配置。
# AIDUMEM_LEGACY_USER_IDS=admin,user

# ── v19.0 认知层（P0 Reflect / 自编辑 / 检索时间窗）──────────────
# Reflect 后台主动反思开关与间隔（小时）。关闭后手动 POST /reflect 不受影响。
# AIDUMEM_REFLECT_ENABLED=true
# AIDUMEM_REFLECT_INTERVAL_HOURS=6
# 记忆去重自编辑开关。关闭后 /add 回退到 Layer1 Jaccard 去重。
# 注意成本：开启时每次写入前会对相似候选做一次 LLM 判重，
# 高频写入场景会增加延迟与 token 消耗；低写入或重质量场景建议开启。
# AIDUMEM_SELF_EDIT_ENABLED=true
# 检索时间衰减率 λ：越大旧记忆衰减越快；0 表示完全不衰减。
# AIDUMEM_RECENCY_LAMBDA=0.01

# ── v19.0 P1（类型分离 / Skill 生长 / 递归精炼）────────────────────
# LLM 辅助判型（开启后写入时用 LLM 判记忆类型；关闭则纯规则判型）
# AIDUMEM_TYPE_CLASSIFY_ENABLED=false
# 自动 Skill 生长：开启后 /skill/grow 允许调用 LLM 生成草稿
# AIDUMEM_SKILL_GROWTH_ENABLED=false
# 记忆递归精炼：开启后 /memory/refine 允许调用 LLM 生成合并摘要
# AIDUMEM_REFINE_ENABLED=false

# ── 相关性闸门词表（★ 最容易漏配的一项）────────────────────────
#
# 闸门先判「这句话需不需要查记忆」，再决定是否召回。判据里的通用模式
# （我的/还记得/上次说过…）内置在源码里，但你专属的人名、昵称、项目
# 代号、机房代号不可能硬编码在开源仓库里 —— 必须从这里注入。
#
# 漏配的后果：问「Alice 的生日是哪天」会被判成 no_signal 直接零召回，
# 且不报错、不打警告，只是查不到。v15 起 GET /health 会在
# probes.entity_keywords_ok=false 时给出 warnings 提示。
#
# 用 `|` 分隔，元字符会被自动转义（当字面量处理）。
# AIDUMEM_ENTITY_KEYWORDS=Alice|Bob|ProjectX|Acme Corp
# AIDUMEM_SERVER_KEYWORDS=tokyo|osaka|prod-cluster
# AIDUMEM_DATE_KEYWORDS=founding day|anniversary

# ── 分层衰减 ────────────────────────────────────────────────────
# L0 = 零衰减（永不降权），按 category 精确匹配
# AIDUMEM_L0_CATEGORIES=iron_law,passphrase,auth
# L1 = 慢衰减，按 category 前缀匹配
# AIDUMEM_L1_PREFIXES=identity_,preference_

# ── v20.0 向量后端契约（P0-5，见 docs/ADR-001 与 ducky/vector_backend.py）──
# 默认 qdrant，不设即 qdrant。sqlite-vec 是显式实验开关，没有静默回退：
# 后端选择是运维决策，不是异常处理分支。换库演练用
# scripts/vector_shadow_poc.py 对着快照拷贝跑，回退 = 删影子文件。
# AIDUMEM_VECTOR_BACKEND=qdrant
# sqlite-vec 实验后端的落盘路径与原生扩展路径（扩展未配置/装不上时，
# require_extension 门禁如实拒绝且不落任何文件；检索目前是 Python 全表
# 扫描余弦，health 里写明 scoring，POC 可用、生产检索不可用）
# AIDUMEM_SQLITE_VEC_PATH=/path/to/shadow_vectors.sqlite
# AIDUMEM_SQLITE_VEC_EXTENSION=/path/to/vec0.dylib

# ── 宿主 Agent 对接（可选）──────────────────────────────────────
# AIDUMEM_HOST_STATE_DB=/path/to/hermes/state.db
# （原 AIDUMEM_HOST_MEMORY_MD 已删：全仓从无代码读它，历史上也没有 ——
#   一个只出现在样例里的键，部署方照着设会以为自己配过了。2026-08-29 自查）

# ── 上游 LLM 网关用量采集（可选，默认关闭，见 ducky/router_usage.py）──
# v19.4.1 P2-4：该模块通过 ssh 在远端主机执行查询脚本，属纯运维观测能力，
# 与记忆主链路无关。默认**不加载不执行**，需要时显式开启并自行确认信任前提
# （远端主机可信、ssh 私钥可信、known_hosts 已预置）。
# AIDUMEM_ROUTER_USAGE_ENABLED=1
# 首次连接的主机密钥策略（默认 accept-new；预置 known_hosts 后建议改 yes）
# AIDUMEM_ROUTER_SSH_STRICT=accept-new
# AIDUMEM_ROUTER_SSH_HOSTS=user@10.0.0.2,user@203.0.113.5
# AIDUMEM_ROUTER_SSH_KEY=/path/to/ssh_private_key
# AIDUMEM_ROUTER_DB_PATH=~/router-data/db/data.sqlite
# AIDUMEM_ROUTER_KEY_SUFFIX=
# AIDUMEM_ROUTER_MODELS=

# ── v20.1 确定性兜底与诚实召回 ─────────────────────────────────────
# WP-A 确定性抽取层开关（1/0；env 显式 > 配置 _features.pattern_extract > 默认开）
# AIDUMEI_PATTERN_EXTRACT=1
# facts 水位告警阈值（正整数；默认 800，与 v20.0.1 行为一致；生效值见 /health）
# AIDUMEI_FACTS_WATERMARK=800
# 召回弃答置信下限（0~1；默认 0.0=只有空结果判 not_found；生产按查询分布分位数校准）
# AIDUMEI_RECALL_VERDICT_THRESHOLD=0.0
# 核心记忆陈旧阈值（天）：全局兜底 + 每块覆盖（块名大写后缀）；默认分级 180/30/180
# AIDUMEI_CORE_STALENESS_DAYS=30
# AIDUMEI_CORE_STALENESS_DAYS_CORE_USER_PROFILE=180
# AIDUMEI_CORE_STALENESS_DAYS_CORE_CURRENT_PROJECT=30
# AIDUMEI_CORE_STALENESS_DAYS_CORE_KEY_DECISIONS=180
# 核心记忆向量索引开关（1/0；默认开；关闭=新写不再进向量召回池）
# AIDUMEI_CORE_VECTOR_INDEX=1

# ── v20.1.1 限流护栏（外审建议采纳；默认值取自生产 14 天日志实测）──
# 写路径每租户每分钟上限（默认 120 = 实测分钟峰值 35 的 3.4 倍；0=关闭）
#AIDUMEI_RATE_ADD_PER_MIN=120
# delete_all 每租户每分钟上限（默认 3；0=关闭）
#AIDUMEI_RATE_DELETE_ALL_PER_MIN=3

# ── v20.2 智慧引擎自动挡 ──
# 本地嵌入模型缓存目录（默认 ~/.cache/aidumei/fastembed；运行时零网络，
# 模型文件用 scripts/fetch_local_embed_model.py 部署期就位）
#AIDUMEI_LOCAL_EMBED_CACHE=~/.cache/aidumei/fastembed
# 熔断参数（工程惯例默认，待生产故障分布校准；见预案 WP-G）
# 嵌入腿（连续失败降挡→冷却→半开真实流量探测→升挡）
# AIDUMEI_GEAR_TRIP_FAILURES=3
# AIDUMEI_GEAR_RECOVER_SUCCESSES=2
# AIDUMEI_GEAR_COOLDOWN_SEC=60
# v20.2.2 LLM 蒸馏腿（与嵌入腿独立；断供时写入降为确定性直写秒回）
# AIDUMEI_LLM_GEAR_TRIP_FAILURES=3
# AIDUMEI_LLM_GEAR_RECOVER_SUCCESSES=2
# AIDUMEI_LLM_GEAR_COOLDOWN_SEC=60

# ── v20.2.3 引擎档位（用户自选，见 README「部署要求」章的双体量对比表）──
# auto  = 自动挡（默认）：云端为主，断供自动切本地备胎，恢复自动切回
# cloud = 云端档：只用云端，本地模型不加载 —— 省下备胎的约 151MB 内存
# local = 本地档：只用本地，零 token、零外部网络、不需要任何密钥
# AIDUMEI_ENGINE_MODE=auto
# 欠账水位告警线（超过它且上次重放无进展 → /health 判 stuck；0=关闭）
# AIDUMEI_PENDING_WARN_LEVEL=500
# 登录失败护栏：每 IP 每分钟允许的失败次数（0=关闭）
# AIDUMEI_LOGIN_FAILURES_PER_MIN=10

# ═══════════════════════════════════════════════════════════════════
# 参赛前自查补录（2026-08-29）
#
# 下面这些键**代码里真的会去读**，但此前不在本文件里 —— 而两份 README 都
# 写着「完整清单连注释见 .env.example」。宣称即承诺：清单说自己完整，
# 就得真的完整。补录后由 tests/test_env_example_is_complete.py 盯着，
# 以后代码里新读一个键而这里没列，测试会红。
# ═══════════════════════════════════════════════════════════════════

# ── 安全相关（这三个直接关系到对外暴露面，务必读一遍）──────────────
# 允许无凭据监听公网。**默认 0，强烈建议保持 0**：设为 1 等于让任何人
# 都能读写这台机器上的全部记忆。仅在你确知前面有反向代理鉴权时才开。
# AIDUMEM_ALLOW_INSECURE_PUBLIC=0
# 注入防御档位：enforce（默认，拦截并中和）/ 其它值按观察模式处理。
# AIDUMEM_INJECTION_GUARD_MODE=enforce

# 记忆显著性衰减（v20.3.2 正式版起字面量命名；此前由代码动态拼名、从未文档化）
# 半衰期（天，下限 0.1）与显著性下限（低于此值且闲置的记忆会被淘汰）
# AIDUMEI_SALIENCE_HALF_LIFE_DAYS=30
# AIDUMEI_SALIENCE_FLOOR=0.2
# 单条记忆正文的字符上限（超长截断，防止一条记忆撑爆上下文）。
# AIDUMEM_MAX_MEMORY_CHARS=

# ── 打分与召回（改这些会直接改变召回结果，改前先读 README 安全边界一节）──
# 复合总分门槛：低于它的候选不进结果集。**默认 0.0（关闭）** ——
# 本机没有足够的查询分布去定生产阈值，拍脑袋常数会把真记忆判成「没有」。
# 要开请先用响应里的 score_histogram 攒真实分布再定值。
# AIDUMEI_RECALL_MIN_HYBRID=0.0
# 重排权重：终态分 = 原分×(1-W) + 重排分×W。
# AIDUMEM_RERANK_WEIGHT=0.4
# 归一化温度（必须严格大于 0，取 0 会除零）。
# AIDUMEM_SIGMOIDAL_TEMP=10.0

# ── 后台作业与人格层 ───────────────────────────────────────────────
# 记忆整合作业的间隔小时数。
# AIDUMEM_CONSOLIDATION_INTERVAL_HOURS=
# 会话结束时是否触发反思（true/false）。
# AIDUMEM_REFLECT_ON_SESSION_END=true
# 人格记忆层开关（true/false）。
# AIDUMEM_PERSONA_ENABLED=true

# ── 路径与宿主集成（一般不需要动）─────────────────────────────────
# 备份根目录（backup_gate.sh / pre-upgrade-check.sh 共用；真实部署建议指向持久盘）
# AIDUMEM_BACKUP_ROOT=
# .env 文件自身的位置（默认仓库根下的 .env）。
# AIDUMEM_ENV_FILE=
# 宿主侧集成用：主机名、状态库、最后处理 id、错误日志。
# AIDUMEM_HOST=
# AIDUMEM_HOST_STATE_DB=
# AIDUMEM_HOST_LAST_ID=
# AIDUMEM_HOST_ERROR_LOG=

# ── 反代信任声明（v20.3.2-beta · 外审 C-1）──
# 无凭据实例只服务**直连本机**。同机 nginx 反代的 TCP 对端恒为 127.0.0.1，
# 所以「对端是回环」骗得过判据 —— 那正是默认安装 + 反代下全站裸奔的成因。
# 现在带任何反代痕迹（X-Forwarded-For / X-Real-IP / Forwarded …）的请求，
# 在无凭据实例上一律 503。若你确实在可信反代之后且明知风险，置 1 放行。
# **更推荐的做法是配一个凭据**（AIDUMEM_API_TOKEN），而不是打开这个开关。
AIDUMEI_TRUST_PROXY=0

# v20.3.2 正式版（P1-12）：无凭据实例的 Host 校验（防 DNS rebinding）。
# 无凭据时只接受 Host 为回环名（localhost / 127.0.0.1 / [::1]）或 AIDUMEM_HOST 的请求，
# 其余回 421 host_not_allowed；浏览器跨站写（Origin 非受信 / Sec-Fetch-Site: cross-site）回 403。
# 若你用自定义主机名直连（如内网 DNS 名），逗号分隔列在这里。配了凭据或 TRUST_PROXY=1 时不生效。
# AIDUMEI_TRUSTED_HOSTS=memory.internal,10.0.0.5
