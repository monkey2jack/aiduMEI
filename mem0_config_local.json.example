{
  "_comment": "aiduMEM 配置模板 — 复制为 mem0_config_local.json 后填入你自己的 key。该文件已在 .gitignore 中，不会被提交。",

  "llm": {
    "provider": "openai",
    "config": {
      "model": "your-llm-model",
      "api_key": "YOUR_LLM_API_KEY",
      "openai_base_url": "https://your-llm-endpoint/v1",
      "temperature": 0.1,
      "max_tokens": 2000
    }
  },

  "embedder": {
    "provider": "openai",
    "config": {
      "model": "your-embedding-model",
      "api_key": "YOUR_EMBEDDING_API_KEY",
      "openai_base_url": "https://your-embedding-endpoint/v1",
      "embedding_dims": 1024
    }
  },

  "vector_store": {
    "provider": "qdrant",
    "config": {
      "collection_name": "aidu_mem",
      "path": "./data/qdrant",
      "embedding_model_dims": 1024,
      "on_disk": true
    }
  },

  "history_db_path": "./data/history.db",

  "_rerank_optional": "可选。配置后混合检索会走 rerank 精排；不配则自动跳过。",
  "rerank": {
    "enabled": false,
    "model": "your-rerank-model",
    "api_key": "YOUR_RERANK_API_KEY",
    "openai_base_url": "https://your-rerank-endpoint/v1"
  }
}
