{
  "plugin_id": "ducky.aidumem",
  "name": "aiduMEI",
  "version": "19.2.0",
  "description": "aiduMEI v19.2.0 · 雅典娜生产加固版：Prompt 注入防护 + 多仓级联原子删除与 WAL + 统一打分体系 + 动态健康观测 + 主动反思自编辑",
  "homepage": "https://github.com/monkey2jack/aiduMEM",
  "license": "MIT",
  "authors": [
    "aidu Team"
  ],
  "capabilities": {
    "tools": [
      {
        "name": "mem0_search",
        "description": "搜索记忆（内置相关性闸门）",
        "requirements": [
          "filesystem"
        ],
        "permission_policy": "auto"
      },
      {
        "name": "mem0_add",
        "description": "添加记忆（自动注册显著性）",
        "requirements": [
          "network",
          "filesystem"
        ],
        "permission_policy": "auto"
      },
      {
        "name": "mem0_recent",
        "description": "获取最近记忆",
        "requirements": [
          "filesystem"
        ],
        "permission_policy": "auto"
      },
      {
        "name": "mem0_stats",
        "description": "记忆统计（含显著性报告）",
        "requirements": [
          "filesystem"
        ],
        "permission_policy": "auto"
      },
      {
        "name": "mem0_delete",
        "description": "删除指定记忆",
        "requirements": [
          "filesystem"
        ],
        "permission_policy": "ask"
      },
      {
        "name": "mem0_delete_all",
        "description": "删除所有记忆（危险操作）",
        "requirements": [
          "filesystem"
        ],
        "permission_policy": "ask"
      },
      {
        "name": "mem0_update",
        "description": "更新指定记忆",
        "requirements": [
          "filesystem"
        ],
        "permission_policy": "auto"
      }
    ],
    "routes": [],
    "web": [],
    "config": {
      "salience_half_life_days": {
        "type": "number",
        "default": 30,
        "description": "显著性半衰期（天）"
      },
      "salience_floor": {
        "type": "number",
        "default": 0.2,
        "description": "显著性踢出阈值"
      },
      "debounce_cooldown_seconds": {
        "type": "number",
        "default": 1800,
        "description": "会话蒸馏冷却时间（秒）"
      },
      "consolidation_interval_hours": {
        "type": "number",
        "default": 24,
        "description": "后台合并间隔（小时）"
      }
    }
  },
  "docs": {
    "readme": "README.md",
    "changelog": "CHANGELOG.md"
  },
  "requires": {
    "mem0_min_version": "1.0.0",
    "python_min_version": "3.10"
  }
}